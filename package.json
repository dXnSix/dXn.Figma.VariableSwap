{
  "name": "variable-swap",
  "version": "1.0.0",
  "description": "Swaps variables using mapping in provided JSON string.",
  "main": "dist/code.js",
  "scripts": {
    "build": "pnpm run build:code && pnpm run build:assets",
    "build:code": "esbuild src/main.ts --bundle --outfile=dist/code.js --target=es2017 --format=iife",
    "build:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('manifest.json','dist/manifest.json');fs.copyFileSync('ui.html','dist/ui.html')\"",
    "watch": "pnpm run build:assets && esbuild src/main.ts --bundle --outfile=dist/code.js --target=es2017 --format=iife --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.122.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
